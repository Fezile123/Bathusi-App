{
  "cli": { "version": ">= 12.0.0", "appVersionSource": "remote" },
  "build": {
    "preview": {
      "distribution": "internal",
      "autoIncrement": true,
      "android": { "buildType": "apk" },
      "env": {
        "EXPO_PUBLIC_DISGUISE_NAME": "FloLog",
        "EXPO_PUBLIC_SHOW_SETUP_BUTTON": "true",
        "EXPO_PUBLIC_DEMO_MODE": "true",
        "EXPO_PUBLIC_REQUIRE_PIN": "false"
      }
    }
  }
}