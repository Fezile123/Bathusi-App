{
  "expo": {
    "name": "FloLog",
    "slug": "mothusi",
    "version": "1.0.0",
    "orientation": "portrait",
    "icon": "./assets/images/icon.png",
    "scheme": "mothusi",
    "userInterfaceStyle": "light",
    "ios": {
      "bundleIdentifier": "com.fezile.flolog",
      "supportsTablet": false
    },
    "android": {
      "package": "com.fezile.flolog",
      "adaptiveIcon": {
        "backgroundColor": "#B73E55",
        "foregroundImage": "./assets/images/android-icon-foreground.png",
        "backgroundImage": "./assets/images/android-icon-background.png",
        "monochromeImage": "./assets/images/android-icon-monochrome.png"
      },
      "predictiveBackGestureEnabled": false
    },
    "web": {
      "favicon": "./assets/images/favicon.png"
    },
    "plugins": [
      "expo-router",
      [
        "expo-splash-screen",
        {
          "backgroundColor": "#B73E55",
          "image": "./assets/images/splash-icon.png",
          "imageWidth": 120
        }
      ],
      "expo-secure-store",
      ["expo-audio", { "microphonePermission": "FloLog uses the microphone only when you choose to record audio." }],
      ["expo-image-picker", { "cameraPermission": "FloLog uses the camera only when you choose to take a photo." }],
      ["expo-location", { "locationWhenInUsePermission": "FloLog uses your location to find nearby support and to include where you are if you send an alert." }]
    ],
    "experiments": {
      "typedRoutes": true,
      "reactCompiler": true
    }
  }
}
